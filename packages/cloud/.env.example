# Open42 cloud-only environment example.

OPEN42_EDITION=cloud
OPEN42_ALLOW_MULTI_WORKSPACE=true
OPEN42_ALLOW_SHARED_KEYS=true

# Stripe billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_MONTHLY_PRICE_ID=
STRIPE_PLATFORM_REQUEST_METERED_PRICE_ID=
STRIPE_PLATFORM_REQUEST_METER_EVENT_NAME=open42_platform_request
OPEN42_BASIC_INCLUDED_REQUESTS=0

# Fly tenant provisioning.
TENANT_PROVISIONER=hybrid
OPEN42_DEFAULT_TENANT_TIER=free
OPEN42_FREE_TENANT_PROVISIONER=hetzner-agent
OPEN42_PRIVATE_TENANT_PROVISIONER=fly
OPEN42_PRIVATE_TENANT_PLANS=team,business
OPEN42_TENANT_PROXY_BASE_URL=https://api.example.com

# Free tenant provisioning through the Hetzner tenant-agent.
HETZNER_TENANT_AGENT_URL=http://10.42.0.3:4317
HETZNER_TENANT_AGENT_TOKEN=

# Private tenant provisioning through Fly Machines.
FLY_API_TOKEN=
FLY_TENANTS_APP_NAME=open42-tenants
FLY_REGION=iad
GBRAIN_TENANT_VOLUME_SIZE_GB=3
