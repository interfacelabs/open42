    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
