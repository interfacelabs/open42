# =====================================================================
# Open42 environment variables — copy to .env.local for development.
# .env.local is gitignored. NEVER commit secrets.
# =====================================================================

# ---- Postgres (Open42's metadata DB; gbrain gets per-tenant pgvector DBs) ----
# The Docker Compose service maps host port -> container 5432. Default host
# port is 54338 (not 5432, to avoid collision with a system Postgres).
# Change POSTGRES_HOST_PORT and DATABASE_URL together if you want a different one.
POSTGRES_HOST_PORT=54338
DATABASE_URL=postgres://open42:open42@localhost:54338/open42

# ---- Edition flags ----
OPEN42_EDITION=community
OPEN42_ALLOW_MULTI_WORKSPACE=false
OPEN42_ALLOW_SHARED_KEYS=false
OPEN42_DISABLE_COMPOSIO=false

# ---- Shared provider keys (off by default in community) ----
# Community should normally use Settings -> API Keys per workspace instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Supabase (magic-link auth; create a free project at supabase.com) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Open42 envelope encryption key ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to AES-GCM encrypt per-tenant gbrain client secrets in Postgres.
OPEN42_KEK=replace-with-32-byte-hex-key
SESSION_SECRET=replace-me

# ---- gbrain tenant provisioning ----
# local-docker creates one local container per signup. compose points Open42 at
# the shared self-host gbrain service.
TENANT_PROVISIONER=local-docker
OPEN42_DEFAULT_TENANT_TIER=free
OPEN42_FREE_TENANT_PROVISIONER=hetzner-agent
OPEN42_PRIVATE_TENANT_PROVISIONER=fly
# Comma-separated operational overrides for hybrid mode.
# OPEN42_FREE_TENANT_WORKSPACE_IDS=
# OPEN42_PRIVATE_TENANT_WORKSPACE_IDS=
# OPEN42_PRIVATE_TENANT_PLANS=team,business
# URL gbrain tenants use to call Open42's provider proxy. In production this can
# be the public API URL or a private-network URL reachable from tenant hosts.
# OPEN42_TENANT_PROXY_BASE_URL=https://api.example.com
# Optional public MCP proxy domain. When set, new tenants use
# https://ws-<workspace-id>.<domain>/mcp as their gbrain public URL.
# OPEN42_GBRAIN_PROXY_DOMAIN=proxy.example.com
# Required when OPEN42_FREE_TENANT_PROVISIONER=hetzner-agent.
# HETZNER_TENANT_AGENT_URL=http://10.42.0.3:4317
# HETZNER_TENANT_AGENT_TOKEN=
OPEN42_SINGLE_WORKSPACE_ID=
OPEN42_TENANT_PROXY_TOKEN=
GBRAIN_BASE_URL=http://gbrain:8080
GBRAIN_TENANT_IMAGE=open42/gbrain-tenant:v0.31.3
GBRAIN_TENANT_PLATFORM=linux/amd64
# Immutable SHA on garrytan/gbrain master at the v0.31.3 release tag.
# Override only for local feature work — production images MUST build from a SHA.
GBRAIN_GIT_REF=9c60b3a068849f695034d82eb6c2b99287f9a054
GBRAIN_LOCAL_PORT_START=18080
GBRAIN_POSTGRES_USER=gbrain
GBRAIN_POSTGRES_DB=gbrain
# Optional stable tenant Postgres password. If unset, the tenant writes a
# generated password to its own mounted volume.
# GBRAIN_POSTGRES_PASSWORD=dev-only-gbrain-password

# ---- gbrain version pin (per Open42 release) ----
GBRAIN_VERSION=0.31.3

# ---- API config ----
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
# Optional explicit override. If unset, dev web derives the port from WEB_PUBLIC_URL.
# WEB_PORT=3000
LANDING_PUBLIC_URL=http://localhost:3002
# Optional explicit override. If unset, dev landing derives the port from LANDING_PUBLIC_URL.
# LANDING_PORT=3002
NEXT_PUBLIC_OPEN42_APP_URL=http://localhost:3000
# NEXT_PUBLIC_OPEN42_DOCS_URL=http://localhost:8000
# Optional public waitlist endpoint override for the landing email capture form.
# If unset, open42.ai posts to the cloud API waitlist and other hosts post to
# the landing app's /api/waitlist route.
# NEXT_PUBLIC_OPEN42_WAITLIST_URL=https://example.com/waitlist
# Landing waitlist notifications use Resend. RESEND_API_KEY is required for
# /api/waitlist to deliver email; OPEN42_WAITLIST_NOTIFY_EMAIL defaults to
# riccardo@interfacelabs.ai.
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=Open42 <noreply@mail.open42.ai>
# OPEN42_WAITLIST_NOTIFY_EMAIL=riccardo@interfacelabs.ai

# ---- Session config ----
SESSION_COOKIE_NAME=open42_session
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
# In cloud production, owner workspace signups are closed unless one of these is
# set or open signups are explicitly enabled. Invited members can still sign in.
# Comma-separated values.
# OPEN42_ALLOWED_EMAILS=founder@example.com,ops@example.com
# OPEN42_ALLOWED_EMAIL_DOMAINS=example.com
# OPEN42_ENABLE_OPEN_SIGNUPS=false

# ---- Connector OAuth state signing ----
# Required for live OAuth connectors and GitHub App install state.
OPEN42_INGEST_HMAC_SECRET=

# ---- Composio (third-party connector platform) ----
COMPOSIO_API_KEY=
COMPOSIO_NOTION_AUTH_CONFIG_ID=
# Optional; only set for self-hosted Composio.
COMPOSIO_BASE_URL=
# Webhook signing secret from the Composio dashboard. Without this the
# /webhooks/composio endpoint returns 503 instead of 5xx-retry-storming.
COMPOSIO_WEBHOOK_SECRET=

# ---- GitHub App connector ----
# Cloud uses the Open42-managed GitHub App through these environment values.
# Community/self-host can leave these empty and create a workspace-owned app
# from the GitHub connection flow.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Public HTTPS base URL gbrain can clone through for private GitHub repos.
# Defaults to API_PUBLIC_URL.
GITHUB_GIT_PROXY_PUBLIC_URL=
