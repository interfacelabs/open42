FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/landing/package.json apps/landing/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/cloud/package.json packages/cloud/package.json
COPY packages/cloud/api/package.json packages/cloud/api/package.json
COPY packages/cloud/api/package-lock.json packages/cloud/api/package-lock.json
COPY packages/cloud-stubs/package.json packages/cloud-stubs/package.json
RUN npm ci

FROM deps AS cloud-deps
RUN npm install --prefix packages/cloud/api --ignore-scripts

FROM deps AS community-build
ENV OPEN42_EDITION=community
COPY . .
RUN npm run build -w @open42/api

FROM cloud-deps AS cloud-build
ENV OPEN42_EDITION=cloud
COPY . .
RUN npm run build -w @open42/api && npm run build:cloud-api

FROM node:20-alpine AS cloud
WORKDIR /app
ENV NODE_ENV=production
ENV OPEN42_EDITION=cloud
COPY --from=cloud-build /app/package.json ./package.json
COPY --from=cloud-build /app/node_modules ./node_modules
COPY --from=cloud-build /app/apps/api/package.json ./apps/api/package.json
COPY --from=cloud-build /app/apps/api/dist ./apps/api/dist
COPY --from=cloud-build /app/apps/api/drizzle.config.ts ./apps/api/drizzle.config.ts
COPY --from=cloud-build /app/apps/api/drizzle.config.community.ts ./apps/api/drizzle.config.community.ts
COPY --from=cloud-build /app/apps/api/drizzle.config.cloud.migrate.ts ./apps/api/drizzle.config.cloud.migrate.ts
COPY --from=cloud-build /app/apps/api/src ./apps/api/src
COPY --from=cloud-build /app/packages/cloud/package.json ./packages/cloud/package.json
COPY --from=cloud-build /app/packages/cloud/api/package.json ./packages/cloud/api/package.json
COPY --from=cloud-build /app/packages/cloud/api/dist ./packages/cloud/api/dist
COPY --from=cloud-build /app/packages/cloud/api/node_modules ./packages/cloud/api/node_modules
COPY --from=cloud-build /app/packages/cloud/migrations ./packages/cloud/migrations
COPY --from=cloud-build /app/packages/cloud/scripts ./packages/cloud/scripts
CMD ["sh", "-c", "npm run db:migrate:cloud -w @open42/api && npm run start -w @open42/api"]

FROM node:20-alpine AS community
WORKDIR /app
ENV NODE_ENV=production
ENV OPEN42_EDITION=community
COPY --from=community-build /app/package.json ./package.json
COPY --from=community-build /app/node_modules ./node_modules
COPY --from=community-build /app/apps/api/package.json ./apps/api/package.json
COPY --from=community-build /app/apps/api/dist ./apps/api/dist
COPY --from=community-build /app/apps/api/drizzle.config.ts ./apps/api/drizzle.config.ts
COPY --from=community-build /app/apps/api/drizzle.config.community.ts ./apps/api/drizzle.config.community.ts
COPY --from=community-build /app/apps/api/src ./apps/api/src
CMD ["sh", "-c", "npm run db:migrate -w @open42/api && npm run start -w @open42/api"]
