FROM oven/bun:1.3-debian

ARG GBRAIN_VERSION=0.27.1

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN bun install -g "gbrain@${GBRAIN_VERSION}" \
  && gbrain --version | grep -q "${GBRAIN_VERSION}"

WORKDIR /data

COPY infra/entrypoint.gbrain-tenant.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
