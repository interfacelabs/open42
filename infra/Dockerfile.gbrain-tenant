FROM alpine:latest

ARG GBRAIN_VERSION=0.27.1
ARG GBRAIN_GIT_REF=garrytan/v0.27.1-multimodal

RUN apk add --no-cache \
  bash \
  ca-certificates \
  curl \
  libstdc++ \
  postgresql18 \
  postgresql18-client \
  postgresql18-contrib \
  postgresql-pgvector \
  su-exec \
  unzip

ENV BUN_INSTALL=/usr/local/bun
ENV PATH=/usr/local/bun/bin:$PATH

RUN curl -fsSL https://bun.sh/install | bash

RUN apk add --no-cache --virtual .build-deps git \
  && git clone --depth 1 --branch "${GBRAIN_GIT_REF}" https://github.com/garrytan/gbrain.git /opt/gbrain \
  && cd /opt/gbrain \
  && bun install \
  && chmod +x /opt/gbrain/src/cli.ts \
  && ln -sf /opt/gbrain/src/cli.ts /usr/local/bin/gbrain \
  && apk del .build-deps \
  && gbrain --version | grep -q "${GBRAIN_VERSION}"

WORKDIR /data

COPY infra/entrypoint.gbrain-tenant.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
