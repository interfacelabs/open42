FROM alpine:edge@sha256:9a341ff2287c54b86425cbee0141114d811ae69d88a36019087be6d896cef241

ARG GBRAIN_VERSION=0.31.3
ARG BUN_VERSION=1.3.10
ARG TARGETARCH
ARG BUN_TARGET=
ARG BUN_SHA256=
# Pinned to the immutable v0.31.3 release commit on garrytan/gbrain master.
# Bumping is a deliberate Open42-release event, not a transparent dependency
# upgrade. Override at build time only for local development on a feature
# branch (e.g. when contributing back to gbrain). Production images MUST build
# from a SHA. gbrain >=0.31.0 requires Bun >=1.3.10 (see gbrain/package.json
# engines field).
ARG GBRAIN_GIT_REF=9c60b3a068849f695034d82eb6c2b99287f9a054

RUN apk add --no-cache \
  bash \
  ca-certificates \
  curl \
  libstdc++ \
  postgresql18=18.4-r0 \
  postgresql18-client=18.4-r0 \
  postgresql18-contrib=18.4-r0 \
  postgresql-pgvector=0.8.1-r0 \
  su-exec \
  unzip

RUN addgroup -g 10001 -S gbrain \
  && adduser -u 10001 -S -D -H -G gbrain gbrain \
  && mkdir -p /data /run/postgresql /app \
  && chown -R gbrain:gbrain /data /run/postgresql /app

ENV BUN_INSTALL=/usr/local/bun
ENV HOME=/data/home
ENV XDG_CACHE_HOME=/data/.cache
ENV PATH=/usr/local/bun/bin:$PATH

RUN set -eux; \
  arch="${TARGETARCH:-$(uname -m)}"; \
  case "${BUN_TARGET:-$arch}" in \
    amd64|x86_64|bun-linux-x64-musl) \
      bun_target="bun-linux-x64-musl"; \
      bun_sha="${BUN_SHA256:-48a6c32277d343db0148ce066336472ffd380358a4d26bb1329714742492d824}"; \
      ;; \
    arm64|aarch64|bun-linux-aarch64-musl) \
      bun_target="bun-linux-aarch64-musl"; \
      bun_sha="${BUN_SHA256:-d2c81365a2e529b78a42330d3a0056e8dbd7896b4a6782c8e392b6532141e34d}"; \
      ;; \
    *) \
      echo "unsupported Bun target architecture: ${BUN_TARGET:-$arch}" >&2; \
      exit 1; \
      ;; \
  esac; \
  curl -fsSLo /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/${bun_target}.zip" \
  && echo "${bun_sha}  /tmp/bun.zip" | sha256sum -c - \
  && unzip -q /tmp/bun.zip -d /tmp \
  && mkdir -p /usr/local/bun/bin \
  && mv "/tmp/${bun_target}/bun" /usr/local/bun/bin/bun \
  && chmod +x /usr/local/bun/bin/bun \
  && rm -rf /tmp/bun.zip "/tmp/${bun_target}"

# Clone-then-checkout-by-ref: --depth 1 --branch only resolves branches/tags,
# not arbitrary SHAs. We accept the larger clone in exchange for an immutable
# pin that survives upstream force-pushes.
RUN apk add --no-cache --virtual .build-deps git \
  && git clone https://github.com/garrytan/gbrain.git /opt/gbrain \
  && cd /opt/gbrain \
  && git checkout "${GBRAIN_GIT_REF}" \
  && bun install \
  && chmod +x /opt/gbrain/src/cli.ts \
  && ln -sf /opt/gbrain/src/cli.ts /usr/local/bin/gbrain \
  && apk del .build-deps \
  && gbrain --version | grep -q "${GBRAIN_VERSION}"

WORKDIR /data

COPY infra/entrypoint.gbrain-tenant.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
