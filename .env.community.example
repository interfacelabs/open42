# Open42 community self-host example.
# Run `npm run setup` to fill secrets into .env. Do not copy placeholder
# secrets into production.

OPEN42_EDITION=community
OPEN42_ALLOW_MULTI_WORKSPACE=false
OPEN42_ALLOW_SHARED_KEYS=false
OPEN42_DISABLE_COMPOSIO=false

# Filled by `npm run setup`.
OPEN42_KEK=
SESSION_SECRET=
OPEN42_INGEST_HMAC_SECRET=
OPEN42_SINGLE_WORKSPACE_ID=
OPEN42_TENANT_PROXY_TOKEN=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Compose service hostname. Use localhost or host.docker.internal when running
# the API outside Docker Compose.
DATABASE_URL=postgres://open42:open42@postgres:5432/open42
REDIS_URL=redis://redis:6379
API_PORT=3001
API_PUBLIC_URL=http://api:3001
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_OPEN42_EDITION=community

TENANT_PROVISIONER=compose
GBRAIN_BASE_URL=http://gbrain:8080
GBRAIN_VERSION=0.31.3
GBRAIN_TENANT_IMAGE=open42/gbrain-tenant:v0.31.3
GBRAIN_POSTGRES_USER=gbrain
GBRAIN_POSTGRES_DB=gbrain

# Optional: enable live Notion OAuth through your own Composio project.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=
COMPOSIO_NOTION_AUTH_CONFIG_ID=
COMPOSIO_WEBHOOK_SECRET=

# Optional: preconfigure GitHub repo sync with a deployment-owned GitHub App.
# If left empty, owners can create a workspace-owned app from the GitHub
# connection flow. Private repos require this API to be reachable at a public
# HTTPS URL so gbrain can clone through the bridge.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_GIT_PROXY_PUBLIC_URL=

# Community is BYOK by default. Set provider keys in Settings after sign-in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
